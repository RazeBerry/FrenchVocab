[Unit]
Description=Back up VocabBuilder data locally

[Service]
Type=oneshot
User=vocabbuilder
Group=vocabbuilder
ExecStart=/opt/vocabbuilder/scripts/deploy/backup_mobile_data.sh
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/vocabbuilder
