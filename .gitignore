# Ignore specific files
French Vocabulary.apkg
exported_words.json
exported_words_*.json
anki_identity_*.json

# Ignore all .apkg files
*.apkg
anki_exports/

# Ignore all .json files
*.json

# Ignore all .log files
*.log
*.aux
*.out

# Backup files
*.bak
.*.lock

*.tex

*.pdf

# Secrets and environment files - NEVER COMMIT
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials.json

# JetBrains IDE settings
.idea/

# Ignore compiled Python bytecode
__pycache__/

# PyPI packaging artifacts
dist/
build/
*.egg-info/

# Ignore macOS custom attributes
.DS_Store
vocab_builder_config.json

# Runtime translation history (machine-local state)
data/history/*.jsonl

# Local delayed-audit scheduler output
.codex_audits/

# Local design/spec notes stay off the public repository; docs/ itself is
# tracked because it holds the routers and contracts AGENTS.md points to.
docs/local/
docs/bulk_add_spec.md
docs/cleanup_spec_2026-06-12.md
docs/composition_spec.md

# Linter and tool caches
.ruff_cache/

# Repository-local scratch artifacts
/tmp/

# Claude Code local settings
.claude/

# The prompt yardstick and its saved runs are source, not artifacts
!scripts/prompt_panel/panel.json
!scripts/prompt_panel/results/*.json
!scripts/knowledge_ratchet_baseline.json
